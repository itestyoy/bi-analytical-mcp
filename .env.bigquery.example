# Copy to .env and edit, then:
#   docker compose -f docker-compose.bigquery.yml up --build

PORT=3000

# YOUR dbt project (profiles.yml targeting BigQuery + the events fact & users dim).
DBT_PROJECT_DIR=./dbt_project
# Catalog/recipes describing your models.
CONFIG_DIR=./config

# BigQuery target.
BQ_PROJECT=my-gcp-project
BQ_DATASET=analytics
BQ_LOCATION=US

# GCP service-account key JSON on the host (mounted read-only into the container).
BQ_KEYFILE=./bq-key.json

# Query/lifecycle tuning.
QUERY_TIMEOUT_SECONDS=120
CONTEXT_TTL_MS=0

# dbt runner timeout (seconds) for all dbt/mf calls (parse/run/show/query). Default 600 (10 min).
# DBT_TIMEOUT_SECONDS=600
# Dedicated timeout (seconds) for the heavy value-index scans — a combined top-k over the
# full events fact can exceed the runner default and get killed. Default 600. Alternatively
# bound the scan with MCP_INDEX_WINDOW_DAYS, or shrink batches with MCP_INDEX_BATCH.
# MCP_INDEX_TIMEOUT_SECONDS=600
# MCP_INDEX_WINDOW_DAYS=90
# MCP_INDEX_BATCH=40

# INCREMENTAL indexing — instead of one multi-hour pass over EVERY column, bound each run and
# let the schedule fill the index over several short runs (stalest-first, resumable). Set a
# per-run budget (minutes) and/or a property cap, and shorten the refresh interval so it churns.
# Unset → one unbounded pass (previous behaviour).
# MCP_INDEX_RUN_BUDGET_MINUTES=30
# MCP_INDEX_MAX_PROPS_PER_RUN=200
# VALUE_INDEX_REFRESH_MS=3600000   # re-run hourly so bounded runs converge, then keep stalest fresh
