{
  "warehouse_dialect": "postgres",
  "anchor_model": "events",
  "models": {
    "events": {
      "dbt_model": "fct_analytics_events",
      "role": "fact",
      "primary_entity": "event",
      "entities": {
        "user": { "column": "appsflyer_id", "type": "foreign" },
        "session": { "column": "session_number", "type": "foreign" }
      },
      "time": { "column": "device_time", "granularity": "day" },
      "event_name": { "column": "event_name" },
      "event_data_column": "event_data",
      "known_events": [
        "first_launch",
        "new_session",
        "end_session",
        "level_started",
        "level_completed",
        "currency_income",
        "currency_outcome",
        "shop_opened",
        "iap_purchase_completed",
        "iap_purchase_failed",
        "ad_started",
        "ad_finished",
        "tutorial",
        "screen_changed"
      ],
      "properties": {
        "level_id": { "type": "int" },
        "chain": { "type": "string" },
        "result": { "type": "string", "values": ["win", "lose"] },
        "method": { "type": "string" },
        "complete_time": { "type": "int" },
        "attempt": { "type": "int" },
        "amount": { "type": "int" },
        "currency": { "type": "string" },
        "value_in_coins": { "type": "int" },
        "source_type": { "type": "string" },
        "source_name": { "type": "string" },
        "monetization_type": { "type": "string" },
        "price_in_usd": { "type": "numeric" },
        "product_id": { "type": "string" },
        "order_id": { "type": "string" },
        "status": { "type": "string", "values": ["success", "failed", "closed"] },
        "ad_type": { "type": "string", "values": ["rewarded", "interstitial", "banner"] },
        "ad_network": { "type": "string", "values": ["admob", "unity", "applovin", "ironsource"] },
        "placement": { "type": "string" },
        "revenue": { "type": "numeric" },
        "is_reward_received": { "type": "string" },
        "is_clicked": { "type": "string" },
        "screen_from": { "type": "string" },
        "screen_to": { "type": "string" },
        "step_id": { "type": "string" }
      }
    },
    "users": {
      "dbt_model": "dim_users",
      "role": "dimension",
      "primary_entity": { "name": "user", "column": "appsflyer_id" },
      "dimensions": {
        "install_date": { "type": "time", "granularity": "day" },
        "platform": { "type": "string", "values": ["android", "ios"] },
        "os_version": { "type": "string" },
        "device_model": { "type": "string" },
        "country": { "type": "string" },
        "region": { "type": "string" },
        "language": { "type": "string" },
        "media_source": { "type": "string" },
        "acquisition_type": { "type": "string", "values": ["organic", "paid"] },
        "campaign_id": { "type": "string" },
        "app_id": { "type": "string" },
        "app_version": { "type": "string" }
      },
      "measures": {
        "users_count": { "agg": "count", "expr": "1" }
      }
    }
  }
}
