{
  "recipes": [
    {
      "id": "active_users_trend",
      "task_type": "trends",
      "title": "Active users & event volume over time (DAU/WAU/MAU)",
      "when_to_use": "How many unique users / events over time, at day/week/month grain.",
      "required_events": [
        "new_session"
      ],
      "required_properties": [],
      "required_user_attrs": [],
      "metric_types": [
        "simple"
      ],
      "create_payload": {
        "name": "active_users",
        "semantic_models": [
          {
            "from": "events",
            "measures": [
              {
                "name": "active_users",
                "agg": "count_distinct",
                "field": "appsflyer_id",
                "event_name": [
                  "new_session"
                ]
              },
              {
                "name": "event_volume",
                "agg": "count",
                "field": "*"
              }
            ]
          }
        ],
        "metrics": [
          {
            "name": "dau",
            "type": "simple",
            "measure": {
              "name": "active_users"
            }
          },
          {
            "name": "events",
            "type": "simple",
            "measure": {
              "name": "event_volume"
            }
          }
        ]
      },
      "example_queries": [
        {
          "metrics": [
            "active_users_dau"
          ],
          "group_by": [
            {
              "time": "metric_time",
              "grain": "day"
            }
          ]
        },
        {
          "metrics": [
            "active_users_dau"
          ],
          "group_by": [
            {
              "time": "metric_time",
              "grain": "week"
            }
          ]
        },
        {
          "metrics": [
            "active_users_dau"
          ],
          "group_by": [
            {
              "time": "metric_time",
              "grain": "month"
            }
          ]
        }
      ],
      "notes": "DAU/MAU ratio (stickiness) = active_users at day vs month grain.",
      "hack": "count_distinct of the entity key = unique actors; group_by {time: metric_time, grain} turns any measure into a time series. Extrapolate: unique-X-over-time = count_distinct(entity) scoped to the X event."
    },
    {
      "id": "metric_by_user_segment",
      "task_type": "segmentation",
      "title": "Metric sliced by a user attribute",
      "when_to_use": "Revenue / payers / ARPPU broken down by country, platform, media_source, acquisition_type or campaign_id.",
      "required_events": [
        "iap_purchase_completed"
      ],
      "required_properties": [
        "price_in_usd"
      ],
      "required_user_attrs": [
        "country",
        "platform",
        "media_source",
        "acquisition_type"
      ],
      "metric_types": [
        "simple",
        "ratio"
      ],
      "create_payload": {
        "name": "rev_segment",
        "use_base_models": [
          "users"
        ],
        "semantic_models": [
          {
            "from": "events",
            "event_scope": {
              "event_name": [
                "iap_purchase_completed"
              ]
            },
            "measures": [
              {
                "name": "revenue",
                "agg": "sum",
                "field": "price_in_usd"
              },
              {
                "name": "payers",
                "agg": "count_distinct",
                "field": "appsflyer_id"
              }
            ]
          }
        ],
        "metrics": [
          {
            "name": "revenue",
            "type": "simple",
            "measure": {
              "name": "revenue"
            }
          },
          {
            "name": "payers",
            "type": "simple",
            "measure": {
              "name": "payers"
            }
          },
          {
            "name": "arppu",
            "type": "ratio",
            "numerator": {
              "name": "revenue"
            },
            "denominator": {
              "name": "payers"
            }
          }
        ]
      },
      "example_queries": [
        {
          "metrics": [
            "rev_segment_revenue"
          ],
          "group_by": [
            "user__country"
          ]
        },
        {
          "metrics": [
            "rev_segment_revenue"
          ],
          "group_by": [
            "user__platform"
          ]
        },
        {
          "metrics": [
            "rev_segment_revenue"
          ],
          "group_by": [
            "user__media_source"
          ]
        },
        {
          "metrics": [
            "rev_segment_arppu"
          ],
          "group_by": [
            "user__acquisition_type"
          ]
        },
        {
          "metrics": [
            "rev_segment_revenue"
          ],
          "group_by": [
            "user__media_source"
          ]
        }
      ],
      "notes": "User attributes via the implicit events.user -> users.user join; campaign_id is a plain string attribute on dim_users (1-hop, like country/platform) — there is no separate campaigns table.",
      "hack": "Any measure + group_by user__<attr> makes the semantic layer auto-join the user dimension — no join written. Extrapolate: segment ANY metric by ANY user attribute the same way."
    },
    {
      "id": "step_conversion_funnel",
      "task_type": "funnel",
      "title": "2-step conversion funnel (level_started -> level_completed)",
      "when_to_use": "Step conversion / completion rate between two events within a window.",
      "required_events": [
        "level_started",
        "level_completed"
      ],
      "required_properties": [],
      "required_user_attrs": [],
      "metric_types": [
        "simple",
        "conversion"
      ],
      "create_payload": {
        "name": "lvl_funnel",
        "use_base_models": [
          "users"
        ],
        "semantic_models": [
          {
            "from": "events",
            "measures": [
              {
                "name": "starters",
                "agg": "count_distinct",
                "field": "appsflyer_id",
                "event_name": [
                  "level_started"
                ]
              },
              {
                "name": "completers",
                "agg": "count_distinct",
                "field": "appsflyer_id",
                "event_name": [
                  "level_completed"
                ]
              }
            ]
          }
        ],
        "metrics": [
          {
            "name": "starters",
            "type": "simple",
            "measure": {
              "name": "starters"
            }
          },
          {
            "name": "completers",
            "type": "simple",
            "measure": {
              "name": "completers"
            }
          },
          {
            "name": "completion_rate",
            "type": "conversion",
            "base_measure": {
              "name": "starters"
            },
            "conversion_measure": {
              "name": "completers"
            },
            "entity": "user",
            "window": "1 day"
          }
        ]
      },
      "example_queries": [
        {
          "metrics": [
            "lvl_funnel_starters",
            "lvl_funnel_completers"
          ]
        },
        {
          "metrics": [
            "lvl_funnel_completion_rate"
          ]
        },
        {
          "metrics": [
            "lvl_funnel_completion_rate"
          ],
          "group_by": [
            "user__country"
          ]
        }
      ],
      "notes": "Conversion base/conversion measures must be count_distinct. No native N-step funnel; chain 2-step conversions or use derived over step counts.",
      "hack": "A funnel step = an event narrowed by an event_data property value, counted as count_distinct(user); step conversion = ratio(next_step / prev_step). Extrapolate to any 2-step drop-off."
    },
    {
      "id": "multistep_funnel",
      "task_type": "funnel",
      "title": "Multi-step funnel where each step = event + property value",
      "when_to_use": "Onboarding/activation funnels whose steps are the SAME event with a different property value (e.g. tutorial step_id=step_1 -> step_2 -> step_3), with step-to-step conversion.",
      "required_events": [
        "tutorial"
      ],
      "required_properties": [
        "step_id"
      ],
      "required_user_attrs": [],
      "metric_types": [
        "simple",
        "conversion"
      ],
      "create_payload": {
        "name": "tut_funnel",
        "semantic_models": [
          {
            "from": "events",
            "measures": [
              {
                "name": "s1",
                "agg": "count_distinct",
                "field": "appsflyer_id",
                "event_name": [
                  "tutorial"
                ],
                "where": [
                  {
                    "property": "step_id",
                    "op": "eq",
                    "value": "step_1"
                  }
                ]
              },
              {
                "name": "s2",
                "agg": "count_distinct",
                "field": "appsflyer_id",
                "event_name": [
                  "tutorial"
                ],
                "where": [
                  {
                    "property": "step_id",
                    "op": "eq",
                    "value": "step_2"
                  }
                ]
              },
              {
                "name": "s3",
                "agg": "count_distinct",
                "field": "appsflyer_id",
                "event_name": [
                  "tutorial"
                ],
                "where": [
                  {
                    "property": "step_id",
                    "op": "eq",
                    "value": "step_3"
                  }
                ]
              }
            ]
          }
        ],
        "metrics": [
          {
            "name": "step1",
            "type": "simple",
            "measure": {
              "name": "s1"
            }
          },
          {
            "name": "step2",
            "type": "simple",
            "measure": {
              "name": "s2"
            }
          },
          {
            "name": "step3",
            "type": "simple",
            "measure": {
              "name": "s3"
            }
          },
          {
            "name": "conv_1_2",
            "type": "conversion",
            "base_measure": {
              "name": "s1"
            },
            "conversion_measure": {
              "name": "s2"
            },
            "entity": "user",
            "window": "7 day"
          },
          {
            "name": "conv_2_3",
            "type": "conversion",
            "base_measure": {
              "name": "s2"
            },
            "conversion_measure": {
              "name": "s3"
            },
            "entity": "user",
            "window": "7 day"
          }
        ]
      },
      "example_queries": [
        {
          "metrics": [
            "tut_funnel_step1",
            "tut_funnel_step2",
            "tut_funnel_step3"
          ]
        },
        {
          "metrics": [
            "tut_funnel_conv_1_2"
          ]
        },
        {
          "metrics": [
            "tut_funnel_conv_2_3"
          ]
        }
      ],
      "notes": "A funnel step is a measure scoped by event_name + a property `where` (event_data value). Steps chain as 2-step conversion metrics (s1->s2, s2->s3); multiply/compose for end-to-end. Could also key the step on level_id, screen_to, placement, etc.",
      "hack": "Chain one count_distinct(user) measure per step (event + property value) and ratio metrics between consecutive steps. Extrapolate to any ordered N-step sequence."
    },
    {
      "id": "nday_retention",
      "task_type": "retention",
      "title": "N-day retention (D1/D7) via conversion window",
      "when_to_use": "Share of newly-acquired users who return (start a session) within N days of first launch.",
      "required_events": [
        "first_launch",
        "new_session"
      ],
      "required_properties": [],
      "required_user_attrs": [],
      "metric_types": [
        "conversion"
      ],
      "create_payload": {
        "name": "retention",
        "semantic_models": [
          {
            "from": "events",
            "measures": [
              {
                "name": "cohort",
                "agg": "count_distinct",
                "field": "appsflyer_id",
                "event_name": [
                  "first_launch"
                ]
              },
              {
                "name": "returned",
                "agg": "count_distinct",
                "field": "appsflyer_id",
                "event_name": [
                  "new_session"
                ]
              }
            ]
          }
        ],
        "metrics": [
          {
            "name": "d1",
            "type": "conversion",
            "base_measure": {
              "name": "cohort"
            },
            "conversion_measure": {
              "name": "returned"
            },
            "entity": "user",
            "window": "1 day"
          },
          {
            "name": "d7",
            "type": "conversion",
            "base_measure": {
              "name": "cohort"
            },
            "conversion_measure": {
              "name": "returned"
            },
            "entity": "user",
            "window": "7 day"
          }
        ]
      },
      "example_queries": [
        {
          "metrics": [
            "retention_d1"
          ]
        },
        {
          "metrics": [
            "retention_d7"
          ]
        },
        {
          "metrics": [
            "retention_d1"
          ],
          "group_by": [
            {
              "time": "metric_time",
              "grain": "day"
            }
          ]
        }
      ],
      "notes": "Cohort = users with a first_launch (acquisition); returned = users who start a new_session within the window. base_measure and conversion_measure are DIFFERENT events so the rate is meaningful (not identically 1.0). Approximates N-day retention via conversion window; exact point-in-time D-N retention is not native to MetricFlow.",
      "hack": "Retention = a conversion metric (base = first/install event, conversion = a later activity event) with window = 'N day'. Extrapolate: change N or the base/return events for any Dn."
    },
