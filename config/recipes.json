      "notes": "Group by install_date (cohort) and metric_time (age). Cumulative LTV per cohort can layer a cumulative metric.",
      "hack": "Pivot a retention measure by install-cohort (a time dimension) against age-in-days. Extrapolate: any cohort-attribute × age-bucket grid."
    },
    {
      "id": "behavioral_cohort",
      "task_type": "behavioral",
      "title": "Behavioral cohort: users who did / didn't do event X",
      "when_to_use": "Segment users by whether they performed a behavior (e.g. purchased), then compare metrics.",
      "required_events": [
        "iap_purchase_completed",
        "new_session"
      ],
      "required_properties": [],
      "required_user_attrs": [],
      "metric_types": [
        "simple"
      ],
      "create_payload": {
        "name": "behavior",
        "semantic_models": [
          {
            "from": "events",
            "measures": [
              {
                "name": "purchases",
                "agg": "sum_boolean",
                "event_name": [
                  "iap_purchase_completed"
                ]
              },
              {
                "name": "sessions",
                "agg": "count",
                "field": "*",
                "event_name": [
                  "new_session"
                ]
              }
            ]
          }
        ],
        "metrics": [
          {
            "name": "purchases",
            "type": "simple",
            "measure": {
              "name": "purchases"
            }
          },
          {
            "name": "sessions",
            "type": "simple",
            "measure": {
              "name": "sessions"
            }
          }
        ]
      },
      "example_queries": [
        {
          "metrics": [
            "behavior_purchases"
          ]
        },
        {
          "metrics": [
            "behavior_sessions"
          ],
          "group_by": [
            {
              "time": "metric_time",
              "grain": "day"
            }
          ]
        }
      ],
      "notes": "Split did/didn't with a Metric() in --where, e.g. `{{ Metric('behavior_purchases', group_by=['user']) }} > 0`.",
      "hack": "Split the population by a behavioral flag (did event X) then measure later behavior on each arm. Extrapolate to any 'did A → compare B' cohort."
    },
