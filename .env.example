# Copy to .env and edit. All values are optional (defaults shown).

# Host port the MCP server is published on.
PORT=3000

# Warehouse dialect the engine targets: duckdb | bigquery (BigQuery: see .env.bigquery.example)
WAREHOUSE_DIALECT=duckdb

# YOUR dbt project (must contain profiles.yml + the events fact & users dim models).
# Mounted into the container at /dbt_project.
DBT_PROJECT_DIR=./dbt_project

# Override the catalog/recipes that describe your models (mounted at /app/config).
CONFIG_DIR=./config

# How long a best-effort warehouse read (column set, freshness) may hold a tool call (max 30;
# queries and builds never hold one — they are tasks), plus lifecycle tuning.
QUERY_TIMEOUT_SECONDS=20
CONTEXT_TTL_MS=0

# PERSISTENCE — value index / job history / memory persist in SQLite on the mounted volume and
# survive a restart (reset OFF by default; needs Node >= 22.5 — the image is node:22-slim).
# MCP_DB=/workspace/mcp.sqlite
# MCP_MEMORY_DB=/workspace/memory.sqlite
# MCP_DB_RESET=false          # set true ONLY to wipe the store on startup

# The DuckDB database file — consumed by profiles.yml as path: "{{ env_var('DUCKDB_PATH') }}".
# Defaults to the `warehouse` volume of docker-compose.yml.
DUCKDB_PATH=/warehouse/analytics.duckdb
