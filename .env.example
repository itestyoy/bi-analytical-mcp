# Every setting the server reads, with its default (src/config.js reads them: a flag is on|off/1|0/
# true|false/yes|no, anything else its default; a number below its minimum is its default). Copy to .env and edit:
#   cp .env.example .env && docker compose up --build
# (BigQuery: .env.bigquery.example + docker-compose.bigquery.yml.)
#
# docker compose passes this whole file into the container (env_file), and the values its own
# `environment:` block sets win over it — those are marked "(set by compose)". A commented line
# shows the default the server uses when the variable is not set.
#
# Rendered from src/settings.js (npm run settings:example) — edit the table there, not this file.

# ───────────────────────── docker compose (host side) ─────────────────────────
# Host port the server is published on.
PORT=3000
# YOUR dbt project on the host (it must contain profiles.yml), mounted at /dbt_project.
DBT_PROJECT_DIR=./dbt_project
# Catalog / recipes on the host, mounted at /config.
CONFIG_DIR=./config

# ───────────────────────── server and HTTP ─────────────────────────
# Address to listen on. Default 127.0.0.1; the image and compose set 0.0.0.0.
# HOST=0.0.0.0
# Hostnames of browser pages allowed to call the server, comma-separated (loopback always is).
# MCP_ALLOWED_ORIGINS=
# Allowed Host header values, comma-separated. Empty: no Host check.
# MCP_ALLOWED_HOSTS=
# How often a long call sends progress to the client (ms). 0: no progress notifications.
# MCP_PROGRESS_INTERVAL_MS=5000
# After how long a waiting call becomes a protocol task (ms; clients with the Tasks extension). 0: at once.
# MCP_TASK_AFTER_MS=3000
# How long a protocol task is kept (seconds).
# MCP_TASK_TTL_SECONDS=3600

# ───────────────────────── dbt project and catalog ─────────────────────────
# Inside the container: the dbt project and the folder with profiles.yml (set by compose).
# DBT_BASE_PROJECT=/dbt_project
# DBT_PROFILES_DIR=/dbt_project
# The profile output to use. Default: the profile's own `target:`.
# DBT_TARGET=
# A standalone catalog file. Default: read from the dbt project (meta.mcp.role), else config/catalog.yml.
# CATALOG_PATH=/config/catalog.yml
# Your recipes, comma-separated; added to the shipped ones (yours win an id collision).
# Default empty; compose sets /config/recipes.json.
# RECIPES_PATH=/config/recipes.json
# duckdb | bigquery. Default: the profile's output type, else duckdb.
WAREHOUSE_DIALECT=duckdb
# 1: skip the start-up check that the project has the models / macros the server needs.
# SKIP_PROJECT_VALIDATION=
# false: do not check the catalog against the real tables at start.
# MCP_GROUND_CATALOG=true
# 1: refuse queries without a time window; 0: allow them. Default: the catalog decides
# (meta.mcp.require_time_range).
# MCP_REQUIRE_TIME_RANGE=

# ───────────────────────── dbt and MetricFlow environments ─────────────────────────
# Where the environments live. Default ./.venvs; the image sets /opt/dbt-envs.
# DBT_ENVS_DIR=/opt/dbt-envs
# The dbt environment: dbt-v2 | dbt-v1 (dbt-v1 runs the python stage on DuckDB).
DBT_ENV=dbt-v2
# The MetricFlow environment.
# MF_ENV=metricflow
# Pin dbt's major version (1 | 2) instead of reading it from the binary.
# DBT_VERSION=auto
# Timeout of one dbt process (seconds). Retentioneering's own default is 3600.
# DBT_TIMEOUT_SECONDS=600
# How long a short warehouse read (column set, freshness) may hold a call (seconds, max 30).
# Queries and builds never hold one: they are tasks.
QUERY_TIMEOUT_SECONDS=20
# A file to append one JSON line per dbt process to: how long it waited for its turn, how long it ran.
# DBT_TIMING_LOG=

# ───────────────────────── store, contexts, error log ─────────────────────────
# The contexts' working folder. Default ./.mcp/ctx; the image sets /workspace.
# MCP_WORKSPACE=/workspace
# The SQLite file: tasks, value index, memory, error log. Default <MCP_WORKSPACE>/mcp.sqlite.
MCP_DB=/workspace/mcp.sqlite
# A file of its own for the memory tool. Default: the shared MCP_DB.
MCP_MEMORY_DB=/workspace/memory.sqlite
# sqlite | memory.
# MCP_DB_BACKEND=sqlite
# true: wipe the store at start (memory and the error log are kept).
MCP_DB_RESET=false
# Drop contexts idle for longer than this (ms). 0: never.
CONTEXT_TTL_MS=0
# Tables built for tasks on BigQuery expire this many days after they are built. 0: keep them.
# MCP_TABLE_EXPIRATION_DAYS=30
# How long the error log keeps a failure (days), and at most how many it keeps.
# MCP_ERROR_RETENTION_DAYS=30
# MCP_ERROR_MAX_ROWS=10000

# ───────────────────────── value index (background profiling of values) ─────────────────────────
# How often to re-index (ms). 0: one pass at start, no schedule. Default 6 hours.
# VALUE_INDEX_REFRESH_MS=21600000
# Top values kept per property.
# VALUE_INDEX_MAX_VALUES=50
# Properties scanned per query.
# MCP_INDEX_BATCH=40
# Scan only the last N days. 0: the whole history.
# MCP_INDEX_WINDOW_DAYS=0
# Timeout of one scan (seconds).
# MCP_INDEX_TIMEOUT_SECONDS=7200
# Re-scan only rows newer than what is indexed and add them up. Turned off by MCP_INDEX_WINDOW_DAYS.
# MCP_INDEX_MERGE=true
# Approximate distinct counts.
# MCP_INDEX_APPROX_DISTINCT=true
# A field whose distinct values are at least this % of its rows is ID-like: its values are not kept.
# 0: no such check.
# MCP_INDEX_HIGH_CARD_PCT=90
# `dbt run` the source models before indexing them. false when an external scheduler builds them.
# MCP_INDEX_DBT_RUN=true
# The selector of that dbt run. Default: every catalog source model.
# MCP_INDEX_DBT_RUN_SELECT=

# ───────────────────────── python pipeline stage ─────────────────────────
# on: offer the stage, the operator configures its runtime; off: hide it. Default: the profile decides.
# MCP_PYTHON_MODELS=
# JSON of dbt python-model config (runtime, timeout, …); wins over what is read from the profile.
# MCP_PYTHON_MODEL_CONFIG={}
# More allowed imports, comma-separated: import_name (preinstalled) or import_name=pip-name.
# MCP_PYTHON_PACKAGES=

# ───────────────────────── path analysis (retentioneering) ─────────────────────────
# on: switch the feature on. Off, none of it exists.
# MCP_RETENTIONEERING=on
# Its environment.
# MCP_RETENTIONEERING_ENV=retentioneering
# JSON of extra dbt config for its python model (on BigQuery: the runtime template, a timeout).
# MCP_RETENTIONEERING_MODEL_CONFIG={"notebook_template_id": "<template id>", "timeout": 3600}

# ───────────────────────── memory search by meaning ─────────────────────────
# openai: search memory by meaning. Unset: fuzzy search only.
# MEMORY_EMBEDDINGS=openai
# Required with MEMORY_EMBEDDINGS=openai.
# OPENAI_API_KEY=
# The embedding model.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Any OpenAI-compatible endpoint. Default: OpenAI's API.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ───────────────────────── dbt profile (read by profiles.yml via env_var) ─────────────────────────
# The DuckDB database file: path: "{{ env_var('DUCKDB_PATH') }}" (on the warehouse volume).
DUCKDB_PATH=/warehouse/analytics.duckdb
