    {
      "id": "level_progression",
      "task_type": "progression",
      "title": "Level progression: completion, attempts, time per level",
      "when_to_use": "Per-level difficulty: starts, completes, completion rate, avg time/attempts.",
      "required_events": [
        "level_started",
        "level_completed"
      ],
      "required_properties": [
        "level_id",
        "complete_time",
        "attempt"
      ],
      "required_user_attrs": [],
      "metric_types": [
        "simple",
        "ratio"
      ],
      "create_payload": {
        "name": "progression",
        "semantic_models": [
          {
            "from": "events",
            "dimensions": [
              {
                "source": "event_property",
                "property": "level_id"
              }
            ],
            "measures": [
              {
                "name": "starts",
                "agg": "count",
                "field": "*",
                "event_name": [
                  "level_started"
                ]
              },
              {
                "name": "completes",
                "agg": "count",
                "field": "*",
                "event_name": [
                  "level_completed"
                ]
              },
              {
                "name": "avg_time",
                "agg": "average",
                "field": "complete_time",
                "event_name": [
                  "level_completed"
                ]
              }
            ]
          }
        ],
        "metrics": [
          {
            "name": "starts",
            "type": "simple",
            "measure": {
              "name": "starts"
            }
          },
          {
            "name": "completes",
            "type": "simple",
            "measure": {
              "name": "completes"
            }
          },
          {
            "name": "completion_rate",
            "type": "ratio",
            "numerator": {
              "name": "completes"
            },
            "denominator": {
              "name": "starts"
            }
          },
          {
            "name": "avg_time",
            "type": "simple",
            "measure": {
              "name": "avg_time"
            }
          }
        ]
      },
      "example_queries": [
        {
          "metrics": [
            "progression_starts",
            "progression_completes"
          ],
          "group_by": [
            "progression_level_id"
          ]
        },
        {
          "metrics": [
            "progression_completion_rate"
          ],
          "group_by": [
            "progression_level_id"
          ]
        }
      ],
      "notes": "Group by the JSON-extracted level_id dimension. Churn-at-level derived from starts of level N vs N+1 in post-processing.",
      "hack": "Group an event measure by a numeric event_data ordinal (level_id) and ratio adjacent values = progression/drop-off. Extrapolate to any per-step numeric progression."
    },
    {
      "id": "monetization_metrics",
      "task_type": "monetization",
      "title": "Monetization: revenue, ARPPU, AOV, by product/channel/day",
      "when_to_use": "IAP revenue, payers, ARPPU, average order value over time and by segment/product.",
      "required_events": [
        "iap_purchase_completed"
      ],
      "required_properties": [
        "price_in_usd",
        "product_id"
      ],
      "required_user_attrs": [
        "country"
      ],
      "metric_types": [
        "simple",
        "ratio"
      ],
      "create_payload": {
        "name": "monetization",
        "use_base_models": [
          "users"
        ],
        "semantic_models": [
          {
            "from": "events",
            "event_scope": {
              "event_name": [
                "iap_purchase_completed"
              ]
            },
            "dimensions": [
              {
                "source": "event_property",
                "property": "product_id"
              }
            ],
            "measures": [
              {
                "name": "revenue",
                "agg": "sum",
                "field": "price_in_usd"
              },
              {
                "name": "payers",
                "agg": "count_distinct",
                "field": "appsflyer_id"
              },
              {
                "name": "purchases",
                "agg": "count",
                "field": "*"
              }
            ]
          }
        ],
        "metrics": [
          {
            "name": "revenue",
            "type": "simple",
            "measure": {
              "name": "revenue"
            }
          },
          {
            "name": "payers",
            "type": "simple",
            "measure": {
              "name": "payers"
            }
          },
          {
            "name": "arppu",
