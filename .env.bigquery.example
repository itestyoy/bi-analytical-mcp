# Copy to .env and edit, then:
#   docker compose -f docker-compose.bigquery.yml up --build

PORT=3000

# YOUR dbt project (profiles.yml targeting BigQuery + the events fact & users dim).
DBT_PROJECT_DIR=./dbt_project
# Catalog/recipes describing your models.
CONFIG_DIR=./config

# BigQuery target.
BQ_PROJECT=my-gcp-project
BQ_DATASET=analytics
BQ_LOCATION=US

# GCP service-account key JSON on the host (mounted read-only into the container).
BQ_KEYFILE=./bq-key.json

# Query/lifecycle tuning.
QUERY_TIMEOUT_SECONDS=120
CONTEXT_TTL_MS=0

# PERSISTENCE — the value index / job history / memory persist in SQLite on the mounted volume,
# so they SURVIVE a container restart. Requires Node >= 22.5 (the image is node:22-slim); if the
# store still reports persisted:false, node:sqlite is unavailable. Reset is OFF by default.
# MCP_DB=/workspace/mcp.sqlite
# MCP_MEMORY_DB=/workspace/memory.sqlite
# MCP_DB_RESET=false          # set true ONLY to wipe the store on startup

# dbt runner timeout (seconds) for ordinary dbt/mf calls (parse/run/show/query). Default 600 (10 min).
# DBT_TIMEOUT_SECONDS=600
# Dedicated timeout (seconds) for the heavy value-index scans — a combined scan over the full
# events fact genuinely needs longer. Default 7200 (2h); separate from the runner timeout above.
# Alternatively bound the scan with MCP_INDEX_WINDOW_DAYS, or shrink batches with MCP_INDEX_BATCH.
# MCP_INDEX_TIMEOUT_SECONDS=7200
# MCP_INDEX_WINDOW_DAYS=90
# MCP_INDEX_BATCH=40

# INCREMENTAL MERGE — re-scan an already-indexed events property only for rows NEWER than its
# watermark and ADD the new counts to what is stored (each cycle scans a small delta, not the
# whole history). DEFAULT ON. Disable with MCP_INDEX_MERGE=false. Mutually exclusive with
# MCP_INDEX_WINDOW_DAYS — setting a rolling window turns merge off (the window takes precedence).
# MCP_INDEX_MERGE=false
# Auto-skip near-unique / ID-like fields once indexed: if a field's distinct values are >= this
# PERCENT of its (non-null) rows, its top-N is noise, so later syncs don't re-scan it (indexed
# once, then left alone). Relative to the field's own size. Default 90; set 0 to disable.
# MCP_INDEX_HIGH_CARD_PCT=90
