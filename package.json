{
  "name": "dbt-semantic-mcp",
  "version": "0.1.0",
  "description": "Declarative dbt Semantic Layer MCP server (streamable HTTP)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "lint:names": "node scripts/check-name-identity.mjs",
    "pretest": "npm run lint:names",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:all": "node --test test/unit/*.test.js test/integration/*.test.js",
    "build:app": "vite build --config src/apps/result-view/vite.config.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.1",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.2.1",
    "fuse.js": "^7.4.2",
    "js-yaml": "^4.1.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@electric-sql/pglite-socket": "^0.1.6",
    "@modelcontextprotocol/client": "^2.1.0",
    "chart.js": "^4.5.1",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
