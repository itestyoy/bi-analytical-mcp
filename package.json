{
  "name": "dbt-semantic-mcp",
  "version": "0.1.0",
  "description": "Declarative dbt Semantic Layer MCP server (streamable HTTP)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "lint:names": "node scripts/check-name-identity.mjs",
    "pretest": "npm run lint:names",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:all": "node --test test/unit/*.test.js test/integration/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.2.1",
    "fuse.js": "^7.4.2",
    "js-yaml": "^4.1.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@electric-sql/pglite-socket": "^0.1.6"
  }
