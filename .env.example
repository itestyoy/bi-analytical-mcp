# Copy to .env and edit. All values are optional (defaults shown).

# Host port the MCP server is published on.
PORT=3000

# Warehouse dialect the engine targets: postgres | bigquery
WAREHOUSE_DIALECT=postgres

# YOUR dbt project (must contain profiles.yml + the events fact & users dim models).
# Mounted into the container at /dbt_project.
DBT_PROJECT_DIR=./dbt_project

# Override the catalog/recipes that describe your models (mounted at /app/config).
CONFIG_DIR=./config

# Query/lifecycle tuning.
QUERY_TIMEOUT_SECONDS=60
CONTEXT_TTL_MS=0

# Warehouse connection — consumed by profiles.yml via env_var(...).
# Defaults match the bundled `warehouse` (Postgres) service.
DBT_PG_HOST=warehouse
DBT_PG_PORT=5432
DBT_PG_USER=analytics
DBT_PG_PASSWORD=analytics
DBT_PG_DBNAME=analytics
DBT_PG_SCHEMA=public
